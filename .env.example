# ==========================================================
# AI-Powered Automatic GitHub Portfolio Configuration
# Copy this file to .env or backend/.env and customize values
# ==========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database Configuration
# Set to MongoDB Atlas or local MongoDB URI (e.g. mongodb://localhost:27017/portfolio)
# If empty or set to "memory", an automatic embedded in-memory MongoDB will be used for zero-setup local dev/test!
MONGODB_URI=memory

# Admin Authentication & Security
SESSION_SECRET=change-this-to-a-very-secure-random-secret-key-min-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-secure-initial-password-123!

# GitHub Integration
# Method A: Personal Access Token (simplest for single-owner personal use)
# Create at https://github.com/settings/tokens (classic with 'repo' scope or fine-grained read permissions)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_yourPersonalAccessTokenHere

# Method B: GitHub OAuth App (optional for interactive connect button)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback

# GitHub Webhook Signature Secret
# Configure this exact secret in your GitHub Repository -> Settings -> Webhooks
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# AI Analysis Provider
# Options: "mock" (offline/test mode), "openai", or "gemini"
AI_PROVIDER=mock
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o-mini

# Publication Defaults
AUTO_PUBLISH_CONFIDENT=true
REQUIRE_REVIEW_ON_SENSITIVE=true
BLOCK_PRIVATE_REPOS_BY_DEFAULT=true
