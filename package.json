{
  "name": "ai-github-portfolio-root",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Automatic GitHub Portfolio Monorepo",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm --prefix backend run test",
    "test": "npm run test:backend",
    "seed": "npm --prefix backend run seed",
    "simulate:push": "npm --prefix backend run simulate:push"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
